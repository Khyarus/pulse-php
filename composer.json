{
    "name": "jgcansi/pulse-php",
    "description": "Lightweight observability, monitoring and telemetry library for PHP 8.1+ and Laravel — fully local, backed by SQLite.",
    "type": "library",
    "keywords": [
        "observability",
        "monitoring",
        "telemetry",
        "profiling",
        "sqlite",
        "laravel",
        "apm",
        "tracing",
        "metrics"
    ],
    "homepage": "https://github.com/jgcansi/pulse-php",
    "license": "MIT",
    "authors": [
        {
            "name": "João Gabriel Cansi Silveira",
            "email": "pugderpy@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/jgcansi/pulse-php/issues",
        "source": "https://github.com/jgcansi/pulse-php",
        "docs": "https://github.com/jgcansi/pulse-php#readme"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "illuminate/support": "Required only for the optional Laravel 9+ integration."
    },
    "autoload": {
        "psr-4": {
            "PulsePHP\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "PulsePHP\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "platform": {
            "php": "8.1.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "PulsePHP\\Laravel\\PulseServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html build/coverage",
        "test:smoke": "php examples/test.php",
        "demo:traffic": "php examples/traffic.php",
        "check-style": "php-cs-fixer fix --dry-run --diff",
        "format": "php-cs-fixer fix",
        "validate": "composer validate --strict",
        "check": [
            "@validate",
            "@check-style",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Runs the PHPUnit test suite.",
        "test:coverage": "Runs the suite and generates an HTML coverage report in build/coverage.",
        "test:smoke": "Runs the end-to-end smoke test (examples/test.php).",
        "demo:traffic": "Generates sample traffic for the dashboard (examples/traffic.php).",
        "check-style": "Checks the code style without modifying files (CI).",
        "format": "Applies code style fixes automatically.",
        "validate": "Validates composer.json in strict mode.",
        "check": "Runs validation, style checks and tests (recommended for local CI)."
    }
}