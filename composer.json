{
  "name": "jgcansi/pulse-php",
  "description": "Biblioteca leve de observabilidade, monitoramento e telemetria para PHP e Laravel.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "João Gabriel Cansi Silveira",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*"
  },
  "suggest": {
    "illuminate/support": "Required only for the optional Laravel 9+ integration."
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "PulsePHP\\": "src/"
    },
    "files": [
      "src/Support/helpers.php"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "PulsePHP\\Laravel\\PulseServiceProvider"
      ]
    }
  }
}