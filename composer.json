{
    "name": "jgcansi/pulse-php",
    "description": "Biblioteca leve de observabilidade, monitoramento e telemetria para PHP 8.1+ e Laravel — 100% local, em SQLite.",
    "type": "library",
    "keywords": [
        "observability",
        "monitoring",
        "telemetry",
        "profiling",
        "sqlite",
        "laravel",
        "apm",
        "tracing",
        "metrics"
    ],
    "homepage": "https://github.com/jgcansi/pulse-php",
    "license": "MIT",
    "authors": [
        {
            "name": "João Gabriel Cansi Silveira",
            "email": "pugderpy@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/jgcansi/pulse-php/issues",
        "source": "https://github.com/jgcansi/pulse-php",
        "docs": "https://github.com/jgcansi/pulse-php#readme"
    },
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },



        "require-dev": {
        "phpunit/phpunit": "^10.5",
        "friendsofphp/php-cs-fixer": "^3.64 <3.68"
    },
    "suggest": {
        "illuminate/support": "Required only for the optional Laravel 9+ integration."
    },
    "autoload": {
        "psr-4": {
            "PulsePHP\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "PulsePHP\\Tests\\": "tests/"
        }
    },
    "config": {
                "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "platform": {
            "php": "8.1.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "PulsePHP\\Laravel\\PulseServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html build/coverage",
        "check-style": "php-cs-fixer fix --dry-run --diff",
        "format": "php-cs-fixer fix",
        "validate": "composer validate --strict",
        "check": [
            "@validate",
            "@check-style",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Executa a suíte de testes com PHPUnit.",
        "test:coverage": "Executa a suíte e gera relatório HTML de cobertura em build/coverage.",
        "check-style": "Verifica o estilo de código sem alterar arquivos (CI).",
        "format": "Aplica automaticamente as correções de estilo de código.",
        "validate": "Valida o composer.json em modo estrito.",
        "check": "Executa validação, verificação de estilo e testes (ideal para CI local)."
    }
}