# ------------------------------------------------------------------
# PulsePHP - variaveis de ambiente de exemplo
#
# Copie para `.env` e ajuste. NUNCA versione o arquivo `.env` real.
# Nenhuma destas variaveis e obrigatoria para o uso standalone via
# `Pulse::init()`; elas afetam a integracao com Laravel e o dashboard.
# ------------------------------------------------------------------

# Nome do servico exibido no dashboard.
# Fallback: APP_NAME (Laravel) e, por fim, "default".
PULSE_SERVICE_NAME=

# Basic Auth do dashboard (deixe ambos vazios para nao exigir Basic Auth).
# Use um segredo forte. Em producao, prefira um gate/SSO em vez de Basic Auth.
PULSE_DASHBOARD_USER=
PULSE_DASHBOARD_PASSWORD=

# Whitelist de IPs permitidos para acessar o dashboard (separados por virgula).
# Ex.: 127.0.0.1,::1
# ATENCAO: por tras de um proxy reverso, garanta que os IPs confiaveis estejam
# configurados (TrustProxies) - caso contrario a whitelist pode ser contornada.
PULSE_DASHBOARD_IPS=
# Caminho do banco SQLite (padrao Laravel: storage/pulse.sqlite).
PULSE_DB_PATH=

# Rota do dashboard no Laravel (padrao: pulse).
PULSE_PATH=

# Fracao (0.0 a 1.0) de requisicoes/jobs gravados. Excecoes sao sempre gravadas.
PULSE_SAMPLE_RATE=1.0

# Caminhos nunca gravados, separados por virgula (* e curinga).
# O dashboard e sempre ignorado.
PULSE_IGNORE_PATHS=/up,/health,/_debugbar/*,/telescope/*,/horizon/*

# Dias de telemetria mantidos. Agende `php artisan pulse:prune` diariamente.
PULSE_RETENTION_DAYS=7

# Alertas avaliados por `php artisan pulse:check` (agende a cada minuto).
PULSE_ALERTS_ENABLED=false
# Webhook generico (json) ou Slack (slack). Discord: use <webhook>/slack.
PULSE_ALERT_WEBHOOK=
PULSE_ALERT_WEBHOOK_FORMAT=json
# E-mails separados por virgula (usa o mailer configurado no Laravel).
PULSE_ALERT_MAIL_TO=
