# Normaliza fim de linha para LF no repositorio
* text=auto eol=lf

# Arquivos binarios
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.svg text

# Nao exportar arquivos de desenvolvimento/CI no pacote distribuido (dist)
/.github                 export-ignore
/tests                   export-ignore
/docs                    export-ignore
/build                   export-ignore
/examples                export-ignore
/.php-cs-fixer.dist.php  export-ignore
/phpunit.xml             export-ignore
/.env.example            export-ignore
/.gitattributes          export-ignore
/.gitignore              export-ignore